{
  "name": "gokan",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.17.0 <23",
    "pnpm": "10.13.1"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gokan/web dev",
    "dev:api": "pnpm --filter @gokan/api dev",
    "dev:showcase": "pnpm --filter @gokan/showcase dev",
    "build:product": "pnpm --filter @gokan/database build && pnpm --filter @gokan/api build && pnpm --filter @gokan/web build",
    "build:showcase": "pnpm --filter @gokan/showcase build",
    "typecheck:product": "pnpm --filter @gokan/api typecheck && pnpm --filter @gokan/web typecheck",
    "typecheck:showcase": "pnpm --filter @gokan/showcase typecheck",
    "prisma:generate": "pnpm --filter @gokan/database prisma:generate",
    "db:migrate": "pnpm --filter @gokan/database db:migrate",
    "db:validate": "pnpm --filter @gokan/database db:validate",
    "bootstrap:admin": "pnpm --filter @gokan/api build && node --env-file=.env apps/api/dist/bootstrap-cli.js"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "22.16.5",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  }
}
