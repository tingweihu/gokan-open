generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum ActivityStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("activity_status")
}

enum StaffRole {
  SYSTEM_ADMIN
  REGISTRATION_FINANCE
  CHECKIN_EXPORT

  @@map("staff_role")
}

enum OrganizationMemberRole {
  LEADER
  DEPUTY

  @@map("organization_member_role")
}

enum ParticipantGender {
  MALE
  FEMALE

  @@map("participant_gender")
}

enum ParticipantGrade {
  GRADE_1
  GRADE_2
  GRADE_3

  @@map("participant_grade")
}

enum LeagueStatus {
  PENDING_CONFIRMATION
  ACTIVE
  DISSOLVED

  @@map("league_status")
}

enum LeagueMemberStatus {
  PENDING
  CONFIRMED

  @@map("league_member_status")
}

enum LeagueQualificationMode {
  ANY
  ALL

  @@map("league_qualification_mode")
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  RETURNED
  CONFIRMED

  @@map("registration_status")
}

enum ScheduleVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("schedule_version_status")
}

enum EventEntrySource {
  REGISTRATION
  LEADER_MEETING

  @@map("event_entry_source")
}

enum TeamAdmissionStatus {
  PENDING
  ADMITTED
  REJECTED

  @@map("team_admission_status")
}

enum PaymentStatus {
  SUBMITTED
  CONFIRMED
  REJECTED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  COMPLETED
  CANCELLED

  @@map("refund_status")
}

enum AttachmentPurpose {
  PAYMENT_PROOF
  TOTAL_ROSTER

  @@map("attachment_purpose")
}

enum LeaderMeetingStatus {
  SCHEDULED
  ENTRY_OPEN
  ENTRY_CLOSED_PARTICIPANT_OPEN
  CLOSED

  @@map("leader_meeting_status")
}

enum LeaderMeetingSnapshotKind {
  BASELINE
  FINAL

  @@map("leader_meeting_snapshot_kind")
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String
  normalizedEmail    String     @unique @map("normalized_email")
  displayName        String     @map("display_name")
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  firstLoginRequired Boolean    @default(true) @map("first_login_required")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions                Session[]
  staffAssignments        ActivityStaff[]
  organizationMemberships OrganizationMembership[]
  consents                UserConsent[]
  leagueConfirmations     LeagueMember[]    @relation("LeagueMemberConfirmer")
  schedulesCreated        ScheduleVersion[] @relation("ScheduleCreator")
  schedulesPublished      ScheduleVersion[] @relation("SchedulePublisher")
  feeSchedulesUpdated     FeeSchedule[]     @relation("FeeScheduleUpdater")
  attachmentsUploaded     Attachment[]      @relation("AttachmentUploader")
  paymentsSubmitted       Payment[]         @relation("PaymentSubmitter")
  paymentsReviewed        Payment[]         @relation("PaymentReviewer")
  refundsCreated          Refund[]          @relation("RefundCreator")
  refundsCompleted        Refund[]          @relation("RefundCompleter")
  meetingsStarted         LeaderMeeting[]  @relation("MeetingStartedBy")
  meetingsEntryClosed     LeaderMeeting[]  @relation("MeetingEntryClosedBy")
  meetingsClosed          LeaderMeeting[]  @relation("MeetingClosedBy")
  meetingSnapshotsCreated LeaderMeetingSnapshot[] @relation("MeetingSnapshotCreator")

  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  acknowledgedPolicyDocumentId String? @map("acknowledged_policy_document_id") @db.Uuid
  acknowledgedAt              DateTime? @map("acknowledged_at") @db.Timestamptz

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedPolicy PolicyDocument? @relation("SessionPolicyAcknowledgement", fields: [acknowledgedPolicyDocumentId], references: [id])

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PolicyDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version      String   @unique
  title        String
  bodyMarkdown String   @map("body_markdown")
  required     Boolean  @default(true)
  publishedAt  DateTime @map("published_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  consents               UserConsent[]
  sessionAcknowledgements Session[]   @relation("SessionPolicyAcknowledgement")

  @@map("policy_documents")
}

model UserConsent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  policyDocumentId String   @map("policy_document_id") @db.Uuid
  acceptedAt       DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy PolicyDocument @relation(fields: [policyDocumentId], references: [id])

  @@unique([userId, policyDocumentId])
  @@map("user_consents")
}

model Activity {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String         @unique
  name                  String
  year                  Int            @unique
  timezone              String         @default("Asia/Taipei")
  status                ActivityStatus @default(DRAFT)
  registrationOpensAt   DateTime?      @map("registration_opens_at") @db.Timestamptz
  registrationClosesAt  DateTime?      @map("registration_closes_at") @db.Timestamptz
  paymentDueAt          DateTime?      @map("payment_due_at") @db.Timestamptz
  leaderMeetingStartsAt DateTime?      @map("leader_meeting_starts_at") @db.Timestamptz
  leaderMeetingEndsAt   DateTime?      @map("leader_meeting_ends_at") @db.Timestamptz
  competitionStartsAt   DateTime?      @map("competition_starts_at") @db.Timestamptz
  competitionEndsAt     DateTime?      @map("competition_ends_at") @db.Timestamptz
  remittanceInstructions String?       @map("remittance_instructions")
  rowVersion            Int            @default(1) @map("row_version")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  staffAssignments ActivityStaff[]
  organizations    Organization[]
  participants     Participant[]
  leagueRule       LeagueRule?
  leagues          League[]
  registrations    Registration[]
  events           CompetitionEvent[]
  scheduleVersions ScheduleVersion[]
  eventTimeWindows EventTimeWindow[]
  eventEntries     EventEntry[]
  participantClaims ParticipantEventClaim[]
  feeSchedule      FeeSchedule?
  eventFeeOverrides EventFeeOverride[]
  attachments      Attachment[]
  payments         Payment[]
  refunds          Refund[]
  leaderMeeting    LeaderMeeting?

  @@map("activities")
}

model LeaderMeeting {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId      String             @unique @map("activity_id") @db.Uuid
  status          LeaderMeetingStatus @default(SCHEDULED)
  rowVersion      Int                @default(1) @map("row_version")
  startedAt       DateTime?          @map("started_at") @db.Timestamptz
  entryClosedAt   DateTime?          @map("entry_closed_at") @db.Timestamptz
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz
  startedById     String?            @map("started_by_id") @db.Uuid
  entryClosedById String?            @map("entry_closed_by_id") @db.Uuid
  closedById      String?            @map("closed_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startedBy     User?    @relation("MeetingStartedBy", fields: [startedById], references: [id])
  entryClosedBy User?    @relation("MeetingEntryClosedBy", fields: [entryClosedById], references: [id])
  closedBy      User?    @relation("MeetingClosedBy", fields: [closedById], references: [id])
  snapshots     LeaderMeetingSnapshot[]

  @@index([activityId, status])
  @@map("leader_meetings")
}

model LeaderMeetingSnapshot {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderMeetingId String                   @map("leader_meeting_id") @db.Uuid
  kind           LeaderMeetingSnapshotKind
  version        Int                       @default(1)
  amountDue      Int                       @map("amount_due")
  capturedAt     DateTime                  @default(now()) @map("captured_at") @db.Timestamptz
  payload        Json                      @db.JsonB
  createdById    String                    @map("created_by_id") @db.Uuid

  leaderMeeting LeaderMeeting @relation(fields: [leaderMeetingId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("MeetingSnapshotCreator", fields: [createdById], references: [id])

  @@unique([leaderMeetingId, kind])
  @@index([leaderMeetingId, capturedAt])
  @@map("leader_meeting_snapshots")
}

model ActivityStaff {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String    @map("activity_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       StaffRole
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, activityId, revokedAt])
  @@map("activity_staff")
}

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  code       String
  name       String
  shortName  String?  @map("short_name")
  active     Boolean  @default(true)
  rowVersion Int      @default(1) @map("row_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  activity           Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  memberships        OrganizationMembership[]
  participants       Participant[]
  ownedLeagues       League[]                 @relation("LeagueOwner")
  leagueMemberships  LeagueMember[]
  registrations      Registration[]

  @@unique([activityId, code])
  @@index([activityId, active])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           OrganizationMemberRole
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  revokedAt      DateTime?              @map("revoked_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, revokedAt])
  @@map("organization_memberships")
}

model Participant {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId           String            @map("activity_id") @db.Uuid
  sourceOrganizationId String            @map("source_organization_id") @db.Uuid
  name                 String
  gender               ParticipantGender
  grade                ParticipantGrade
  active               Boolean           @default(true)
  rowVersion           Int               @default(1) @map("row_version")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  activity           Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sourceOrganization Organization @relation(fields: [sourceOrganizationId], references: [id])
  teamMemberships    TeamMember[]
  eventClaims        ParticipantEventClaim[]

  @@index([activityId, sourceOrganizationId, active])
  @@map("participants")
}

model LeagueRule {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId          String @unique @map("activity_id") @db.Uuid
  minimumMemberClubs  Int    @default(2) @map("minimum_member_clubs")
  maximumMemberClubs  Int?   @map("maximum_member_clubs")
  minimumParticipants Int?   @map("minimum_participants")
  maximumParticipants Int?   @map("maximum_participants")
  lowParticipantQualificationEnabled Boolean @default(true) @map("low_participant_qualification_enabled")
  lowParticipantThreshold Int? @default(15) @map("low_participant_threshold")
  genderImbalanceQualificationEnabled Boolean @default(true) @map("gender_imbalance_qualification_enabled")
  minorityGenderRatioPercent Int? @default(25) @map("minority_gender_ratio_percent")
  qualificationMode LeagueQualificationMode @default(ANY) @map("qualification_mode")
  singleGenderExceptionEnabled Boolean @default(true) @map("single_gender_exception_enabled")
  singleGenderExceptionMaximumMemberClubs Int? @map("single_gender_exception_maximum_member_clubs")
  singleGenderExceptionMaximumParticipants Int? @default(35) @map("single_gender_exception_maximum_participants")
  rowVersion          Int    @default(1) @map("row_version")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("league_rules")
}

model League {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId          String       @map("activity_id") @db.Uuid
  name                String
  ownerOrganizationId String       @map("owner_organization_id") @db.Uuid
  status              LeagueStatus @default(PENDING_CONFIRMATION)
  rowVersion          Int          @default(1) @map("row_version")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  activity      Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  owner         Organization @relation("LeagueOwner", fields: [ownerOrganizationId], references: [id])
  members       LeagueMember[]
  registrations Registration[]

  @@unique([activityId, name])
  @@index([activityId, status])
  @@map("leagues")
}

model LeagueMember {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId        String             @map("activity_id") @db.Uuid
  leagueId          String             @map("league_id") @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  status            LeagueMemberStatus @default(PENDING)
  confirmedByUserId String?            @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  confirmedBy  User?        @relation("LeagueMemberConfirmer", fields: [confirmedByUserId], references: [id])

  @@unique([leagueId, organizationId])
  @@index([organizationId, status])
  @@map("league_members")
}

model Registration {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId     String             @map("activity_id") @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  leagueId       String?            @map("league_id") @db.Uuid
  status         RegistrationStatus @default(DRAFT)
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz
  confirmedAt    DateTime?          @map("confirmed_at") @db.Timestamptz
  returnedAt     DateTime?          @map("returned_at") @db.Timestamptz
  returnReason   String?            @map("return_reason")
  totalRosterAttachmentId String?    @unique @map("total_roster_attachment_id") @db.Uuid
  rowVersion     Int                @default(1) @map("row_version")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  activity     Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  league       League?       @relation(fields: [leagueId], references: [id])
  eventEntries EventEntry[]
  eventClaims  ParticipantEventClaim[]
  payments     Payment[]
  refunds      Refund[]
  totalRosterAttachment Attachment? @relation("RegistrationTotalRoster", fields: [totalRosterAttachmentId], references: [id], onDelete: SetNull)

  @@unique([activityId, organizationId])
  @@unique([activityId, leagueId])
  @@index([activityId, status])
  @@map("registrations")
}

model CompetitionEvent {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId              String             @map("activity_id") @db.Uuid
  code                    String
  name                    String
  displayOrder            Int                @map("display_order")
  enabled                 Boolean            @default(true)
  minTeamSize             Int?               @map("min_team_size")
  maxTeamSize             Int?               @map("max_team_size")
  maxTeamsPerRegistration Int                @default(1) @map("max_teams_per_registration")
  teamCapacity            Int?               @map("team_capacity")
  allowClub               Boolean            @default(true) @map("allow_club")
  allowLeague             Boolean            @default(true) @map("allow_league")
  genderRule              ParticipantGender? @map("gender_rule")
  allowedGrades           ParticipantGrade[] @default([]) @map("allowed_grades")
  rulesJson               Json?              @map("rules_json") @db.JsonB
  rowVersion              Int                @default(1) @map("row_version")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  activity       Activity                @relation(fields: [activityId], references: [id], onDelete: Cascade)
  timeWindows    EventTimeWindow[]
  eventEntries   EventEntry[]
  eventClaims    ParticipantEventClaim[]
  feeOverrides   EventFeeOverride[]

  @@unique([activityId, code])
  @@index([activityId, enabled, displayOrder])
  @@map("competition_events")
}

model ScheduleVersion {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId    String                @map("activity_id") @db.Uuid
  version       Int
  status        ScheduleVersionStatus @default(DRAFT)
  createdById   String                @map("created_by_id") @db.Uuid
  publishedById String?               @map("published_by_id") @db.Uuid
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz
  rowVersion    Int                   @default(1) @map("row_version")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  activity    Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("ScheduleCreator", fields: [createdById], references: [id])
  publishedBy User?             @relation("SchedulePublisher", fields: [publishedById], references: [id])
  timeWindows EventTimeWindow[]

  @@unique([activityId, version])
  @@index([activityId, status])
  @@map("schedule_versions")
}

model EventTimeWindow {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId        String   @map("activity_id") @db.Uuid
  scheduleVersionId String   @map("schedule_version_id") @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  ordinal           Int      @default(1)
  startAt           DateTime @map("start_at") @db.Timestamptz
  endAt             DateTime @map("end_at") @db.Timestamptz
  venue             String?
  label             String?

  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  scheduleVersion ScheduleVersion  @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  event           CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, eventId, ordinal])
  @@index([activityId, eventId, startAt, endAt])
  @@map("event_time_windows")
}

model EventEntry {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId     String           @map("activity_id") @db.Uuid
  registrationId String           @map("registration_id") @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  source         EventEntrySource @default(REGISTRATION)
  active         Boolean          @default(true)
  rowVersion     Int              @default(1) @map("row_version")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  activity     Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        CompetitionEvent @relation(fields: [eventId], references: [id])
  teams        Team[]
  teamMembers  TeamMember[]
  eventClaims  ParticipantEventClaim[]

  @@unique([registrationId, eventId])
  @@index([activityId, eventId, active])
  @@map("event_entries")
}

model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventEntryId String   @map("event_entry_id") @db.Uuid
  ordinal      Int
  name         String?
  admissionStatus TeamAdmissionStatus @default(ADMITTED) @map("admission_status")
  rowVersion   Int      @default(1) @map("row_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  eventEntry EventEntry   @relation(fields: [eventEntryId], references: [id], onDelete: Cascade)
  members    TeamMember[]

  @@unique([eventEntryId, ordinal])
  @@map("teams")
}

model TeamMember {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId    String    @map("activity_id") @db.Uuid
  eventEntryId  String    @map("event_entry_id") @db.Uuid
  teamId        String    @map("team_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  active        Boolean   @default(true)
  rowVersion    Int       @default(1) @map("row_version")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  removedAt     DateTime? @map("removed_at") @db.Timestamptz

  eventEntry  EventEntry  @relation(fields: [eventEntryId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([eventEntryId, participantId])
  @@index([activityId, participantId, active])
  @@map("team_members")
}

model ParticipantEventClaim {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  participantId  String   @map("participant_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  eventEntryId   String   @map("event_entry_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  activity     Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  event        CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant  Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventEntry   EventEntry       @relation(fields: [eventEntryId], references: [id], onDelete: Cascade)

  @@unique([activityId, eventId, participantId])
  @@unique([eventEntryId, participantId])
  @@index([registrationId, eventId])
  @@map("participant_event_claims")
}

model FeeSchedule {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId          String   @unique @map("activity_id") @db.Uuid
  registrationBaseFee Int      @map("registration_base_fee")
  participantFee      Int      @map("participant_fee")
  defaultTeamEntryFee Int      @map("default_team_entry_fee")
  updatedById         String   @map("updated_by_id") @db.Uuid
  rowVersion          Int      @default(1) @map("row_version")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  activity     Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  updatedBy    User               @relation("FeeScheduleUpdater", fields: [updatedById], references: [id])
  feeOverrides EventFeeOverride[]

  @@map("fee_schedules")
}

model EventFeeOverride {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId    String @map("activity_id") @db.Uuid
  feeScheduleId String @map("fee_schedule_id") @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  teamEntryFee  Int    @map("team_entry_fee")

  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule      @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  event       CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([feeScheduleId, eventId])
  @@map("event_fee_overrides")
}

model Attachment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId   String            @map("activity_id") @db.Uuid
  uploadedById String            @map("uploaded_by_id") @db.Uuid
  purpose      AttachmentPurpose
  storageKey   String            @unique @map("storage_key")
  originalName String            @map("original_name")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  sha256       String
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  payments   Payment[]
  totalRosterRegistration Registration? @relation("RegistrationTotalRoster")

  @@index([activityId, purpose, createdAt])
  @@map("attachments")
}

model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId          String        @map("activity_id") @db.Uuid
  registrationId      String        @map("registration_id") @db.Uuid
  amount              Int
  paidAt              DateTime      @map("paid_at") @db.Timestamptz
  payerName           String?       @map("payer_name")
  bankAccountLastFive String?       @map("bank_account_last_five")
  reference           String?
  status              PaymentStatus @default(SUBMITTED)
  proofAttachmentId   String?       @map("proof_attachment_id") @db.Uuid
  submittedByUserId   String        @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId    String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at") @db.Timestamptz
  reviewNote          String?       @map("review_note")
  rowVersion          Int           @default(1) @map("row_version")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attachment   Attachment?  @relation(fields: [proofAttachmentId], references: [id], onDelete: SetNull)
  submittedBy  User         @relation("PaymentSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy   User?        @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id])

  @@index([registrationId, status, paidAt])
  @@index([activityId, status])
  @@map("payments")
}

model Refund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId        String       @map("activity_id") @db.Uuid
  registrationId    String       @map("registration_id") @db.Uuid
  amount            Int
  reason            String
  status            RefundStatus @default(REQUESTED)
  createdByUserId   String       @map("created_by_user_id") @db.Uuid
  completedByUserId String?      @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz
  rowVersion        Int          @default(1) @map("row_version")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("RefundCreator", fields: [createdByUserId], references: [id])
  completedBy  User?        @relation("RefundCompleter", fields: [completedByUserId], references: [id])

  @@index([registrationId, status])
  @@index([activityId, status])
  @@map("refunds")
}



model LoginAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountKey String   @map("account_key")
  sourceKey  String   @map("source_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([accountKey, createdAt], map: "login_attempts_account_created_idx")
  @@index([sourceKey, createdAt], map: "login_attempts_source_created_idx")
  @@index([createdAt], map: "login_attempts_created_idx")
  @@map("login_attempts")
}
